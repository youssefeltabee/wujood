# Wujood environment template. Copy to .env and fill in. Never commit .env.

# --- Database (required) ---
# Prisma connection; without it every Prisma query and `prisma db push` fails.
DATABASE_URL=postgresql://user:password@host:5432/wujood
# Direct (non-pooled) connection used by Prisma for migrations/db push; without it db push can hang or fail behind PgBouncer/Supavisor.
DIRECT_URL=postgresql://user:password@host:5432/wujood

# --- Auth (required) ---
# JWT signing secret; without a random value of 32+ chars the app refuses to start (weak/placeholder values rejected).
JWT_SECRET=

# --- Token encryption ---
# AES key material for social-account OAuth tokens at rest; without it connecting social accounts throws.
TOKEN_ENCRYPTION_KEY=

# --- Background jobs (QStash) ---
# QStash API token; without it audits never run (enqueueJob cannot publish to /api/jobs/*).
QSTASH_TOKEN=
# QStash signature keys; without them all /api/jobs/* endpoints reject every request with 401.
QSTASH_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public base URL QStash calls back to; wrong/missing value means jobs are delivered to the wrong host and fail.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Bearer secret Vercel Cron sends to /api/jobs/cleanup; without it the nightly cleanup cron gets 401.
CRON_SECRET=

# --- Rate limiting (Upstash Redis) ---
# Without these, rate limiting silently falls back to in-memory per-instance limits (resets on every deploy/restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- WhatsApp (Twilio) ---
# Without these, sending real WhatsApp messages fails when WA_MOCK is not "true".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Set to "true" to stub outbound WhatsApp sends instead of calling Twilio; anything else uses live Twilio credentials.
WA_MOCK=false

# --- Payments (Fawry) ---
# Without merchant code/security key, Fawry signature verification rejects every payment callback as tampered.
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
# Fawry API base URL (sandbox vs production).
FAWRY_BASE_URL=https://atfawry.fawrypay.com/api

# --- Email (Resend) ---
# Without it, transactional emails fail to send.
RESEND_API_KEY=

# --- AI chatbot (OpenAI) ---
# Without it, /api/chat returns an error instead of AI responses.
OPENAI_API_KEY=

# --- Logging ---
# Optional log level (debug|info|warn|error); defaults to info.
LOG_LEVEL=info
